# Copy to .env on the server and chmod 600 it. Never commit the real file.

# Every route except /api/v1/health asks for HTTP Basic auth when this is set.
# Required in production: the service serves national IDs and statements.
ACCESS_USERNAME=underwriter
ACCESS_PASSWORD=

ALLOWED_ORIGINS=https://underwriting.example.com
MAX_UPLOAD_MB=25
MAX_STATEMENT_FILES=12
LOG_LEVEL=INFO

# Apps Script intake. Leave blank to keep /api/v1/intake/assess closed.
# Generate with: openssl rand -hex 32   (same value as LEDGER_TOKEN in Apps Script)
INTAKE_TOKEN=

# Save to Sheets. Both must be set or the button stays hidden. With the root
# compose.yaml the key goes in ./secrets/ and is read from /run/secrets/.
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=

# JSON archive: every finished assessment as <name>_<national id>/<date>_<time>.json,
# e.g. mugisha-eric_1199080000000001/2026-11-25_16-47-03.json.
# This is the path inside the container; on the host it is ./data/assessments.
# Leave blank to turn it off.
ASSESSMENTS_DIR=/data/assessments

# Root compose.yaml only: 0.0.0.0 shares the port on the LAN without nginx,
# and HOST_PORT changes the port when 8000 is taken (update nginx to match).
# BIND_ADDRESS=127.0.0.1
# HOST_PORT=8000

# Root compose.yaml only, when nginx already runs in a container on this host:
# joins its network so it can proxy to http://crb-statement-analyzer:8000.
# COMPOSE_FILE=compose.yaml:compose.proxy.yaml
# PROXY_NETWORK=

# Root compose.yaml only, with no nginx: the team uses http://<server-ip>:8000
# and the intake sheet uses https://<NGROK_DOMAIN>. See compose.ngrok.yaml.
# BIND_ADDRESS=0.0.0.0
# COMPOSE_FILE=compose.yaml:compose.ngrok.yaml
# NGROK_AUTHTOKEN=
# NGROK_DOMAIN=

# Image tag deploy.sh runs when none is given on the command line.
IMAGE_TAG=latest
